# ============================================
# DEPLOY ALFA AUTOMÁTICO — copie para .env.alfa
# cp .env.alfa.example .env.alfa  (e preencha)
# ============================================

# --- Supabase (obrigatório) ---
# Supabase → Project Settings → Database → Connection string (URI)
# Pode colar a URI direta (db.*.supabase.co) — os scripts convertem automaticamente
# para o pooler IPv4 (*.pooler.supabase.com), necessário no Render.
# Região do pooler (opcional): SUPABASE_POOLER_REGION=aws-1-sa-east-1
#
# Forma automática (sem colar URI inteira):
# SUPABASE_PROJECT_REF=seu_projeto
# SUPABASE_DB_PASSWORD=sua_senha
# Depois: node scripts/configurar-supabase.js
#
# Ou copie a URI no Supabase e rode:
# node scripts/configurar-supabase.js --colar
# AUTO_SUPABASE_CLIPBOARD=true   # lê clipboard em todo deploy/sync
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# --- GitHub (sincronizar repos) ---
# GitHub → Settings → Developer settings → Fine-grained personal access token
# Repositório: integrativoapp (Contents + Administration)
# Repositório: integrativoappespelho (Contents + Administration) — para arquivar espelho vazio
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
GITHUB_OWNER=integrativostein-lab
GITHUB_REPO=integrativoapp
GITHUB_REPO_ESPELHOR=integrativoappespelho

# --- Render (obrigatório para configurar backend) ---
# Render → Account Settings → API Keys → Create API Key
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxx
# Repositório único no GitHub (alfa + produção usam o mesmo código)
GITHUB_REPO=integrativostein-lab/integrativoapp
GITHUB_BRANCH=master
# Nome do serviço alfa no Render
RENDER_SERVICE_NAME=integrativoappespelho
# Nome do serviço produção no Render (tente integra-backend-ynrd ou integra-backend)
RENDER_PROD_SERVICE_NAME=integra-backend-ynrd
# Opcional: se souber o ID, preencha (senão o script descobre pelo nome)
# RENDER_SERVICE_ID=srv-xxxxxxxx
# PROD_DATABASE_URL=   # só se quiser o script atualizar banco de produção
# PROD_JWT_SECRET=

# JWT do backend alfa (deixe vazio para gerar automaticamente)
# JWT_SECRET=

# --- Vercel (obrigatório para publicar site alfa) ---
# vercel.com/account/tokens → Create Token
VERCEL_TOKEN=xxxxxxxxxxxxxxxx
VERCEL_PROJECT_NAME=integrativoapp-alfa
VERCEL_SCOPE=mauricio-s-projects19

# --- URLs alfa (normalmente não precisa mudar) ---
ALFA_API_URL=https://integrativoappespelho.onrender.com/api
ALFA_FRONTEND_URL=https://integrativoapp-alfa.vercel.app
CORS_ORIGINS=https://integrativoapp-alfa.vercel.app,https://alfa.integrativoapp.com,https://www.alfa.integrativoapp.com,https://teste.integrativoapp.com,https://www.teste.integrativoapp.com

# Modo lançamento — false até certificações (prescrição/conselhos/FHIR dormentes)
RECURSOS_CLINICOS_ATIVOS=false

# --- LiveKit (opcional — teleconsulta) ---
# LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
