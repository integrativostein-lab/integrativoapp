# ============================================
# DEPLOY ALFA AUTOMÁTICO — copie para .env.alfa
# cp .env.alfa.example .env.alfa  (e preencha)
# ============================================

# --- Supabase (obrigatório) ---
# Supabase → Project Settings → Database → Connection string (URI)
# No Render, prefira o pooler (IPv4): Session mode → URI com host *.pooler.supabase.com
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# --- Render (obrigatório para configurar backend) ---
# Render → Account Settings → API Keys → Create API Key
RENDER_API_KEY=rnd_xxxxxxxxxxxxxxxx
# Nome do serviço no Render (padrão: integrativoappespelho)
RENDER_SERVICE_NAME=integrativoappespelho
# Opcional: se souber o ID, preencha (senão o script descobre pelo nome)
# RENDER_SERVICE_ID=srv-xxxxxxxx

# JWT do backend alfa (deixe vazio para gerar automaticamente)
# JWT_SECRET=

# --- Vercel (obrigatório para publicar site alfa) ---
# vercel.com/account/tokens → Create Token
VERCEL_TOKEN=xxxxxxxxxxxxxxxx
VERCEL_PROJECT_NAME=integrativoapp-alfa
VERCEL_SCOPE=mauricio-s-projects19

# --- URLs alfa (normalmente não precisa mudar) ---
ALFA_API_URL=https://integrativoappespelho.onrender.com/api
ALFA_FRONTEND_URL=https://integrativoapp-alfa.vercel.app
CORS_ORIGINS=https://integrativoapp-alfa.vercel.app

# --- LiveKit (opcional — teleconsulta) ---
# LIVEKIT_URL=wss://seu-projeto.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
