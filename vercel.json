{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/profissionais.html",
      "destination": "/profissionais",
      "permanent": false
    },
    {
      "source": "/(.*).html",
      "destination": "/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
