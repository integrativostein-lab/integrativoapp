# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================
PORT=3000
NODE_ENV=development
TEST_MODE=false
# false = modo lançamento (terapeutas integrativos; prescrição/conselhos dormentes)
RECURSOS_CLINICOS_ATIVOS=false
TESTE=C:\Users\integ\Dropbox\integrativo-app-v2.1.0-TESTE
TESTE_DATABASE_URL=postgresql://usuario:senha@localhost:5432/integrativo_teste
SIMULAR_NF_SEM_CERTIFICADO=false

# ============================================
# BANCO DE DADOS — POSTGRESQL (NÃO UTILIZAMOS SQLITE)
# Supabase em produção; Postgres local via Docker para desenvolvimento.
# ============================================
DATABASE_URL=postgresql://usuario:senha@localhost:5432/integrativo
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=integrativo

# ============================================
# AUTENTICAÇÃO
# ============================================
JWT_SECRET=sua_chave_secreta_super_segura_aqui
BCRYPT_ROUNDS=10

# Criador — NÃO fica no código-fonte (apenas no servidor Render).
# Painel Render → integra-backend-ynrd → Environment:
#   CRIADOR_EMAIL=integrativostein@gmail.com
#   CRIADOR_SENHA=<senha que você escolher para login no Integrativo.App>
#   CRIADOR_NOME=Mauricio Stein
# Depois rode uma vez: node backend/garantir-criador.js
# (Pode ser a mesma senha do Gmail, mas o login social Google usa OAuth — não essa senha.)
CRIADOR_EMAIL=integrativostein@gmail.com
CRIADOR_SENHA=
CRIADOR_NOME=Mauricio Stein

# ============================================
# LOGIN SOCIAL (Google, Apple, Microsoft)
# ============================================
# URLs de callback no painel de cada provedor:
#   https://integra-backend-ynrd.onrender.com/api/auth/oauth/google/callback
#   https://integra-backend-ynrd.onrender.com/api/auth/oauth/microsoft/callback
#   https://integra-backend-ynrd.onrender.com/api/auth/oauth/apple/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# ============================================
# INTEGRAÇÕES EXTERNAS - FHIR E CIENTÍFICAS
# ============================================
FHIR_HAPI_URL=https://hapi.fhir.org.br/fhir
FHIR_BASE_URL=http://localhost:3000/api/fhir
RNDS_ENABLED=false
RNDS_AUTH_URL=https://ehr-services.saude.gov.br/api/auth/token
FIOCRUZ_API_KEY=seu_token_fiocruz
FIOCRUZ_API_URL=https://arca.fiocruz.br/api
REDEPICS_API_KEY=seu_token_redepics
REDEPICS_API_URL=https://redepicsbrasil.org.br/api
BIREME_API_KEY=seu_token_bireme
BIREME_API_URL=https://www.bireme.org.br/api

# ============================================
# GATEWAYS DE PAGAMENTO
# ============================================
PAGSEGURO_EMAIL=seu_email@pagseguro.com.br
PAGSEGURO_TOKEN=seu_token_pagseguro
PAGBANK_ID=seu_id_pagbank
PAGBANK_KEY=sua_chave_pagbank
ASAAS_API_KEY=sua_chave_asaas
TON_AFFILIATE_CODE=seu_codigo_ton
MERCADOPAGO_ACCESS_TOKEN=seu_token_mp
EFI_CLIENT_ID=seu_client_id_efi
EFI_CLIENT_SECRET=seu_client_secret_efi
CIELO_MERCHANT_ID=seu_merchant_id_cielo
CIELO_MERCHANT_KEY=sua_merchant_key_cielo
STONE_API_KEY=sua_api_key_stone

# ============================================
# STRIPE (ALTERNATIVO)
# ============================================
STRIPE_SECRET_KEY=sk_test_seu_token_stripe
STRIPE_PUBLIC_KEY=pk_test_seu_token_publico

# ============================================
# COMUNICAÇÃO
# ============================================
SENDGRID_API_KEY=sua_chave_sendgrid
SMTP_HOST=smtp.seuservidor.com
SMTP_PORT=587
SMTP_USER=seu_email@seudominio.com
SMTP_PASS=sua_senha_smtp
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE=+55119999999999

# WhatsApp via Evolution API
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua_chave_evolution
EVOLUTION_INSTANCE=integrativo
EVOLUTION_TIMEOUT_MS=15000
EVOLUTION_SIMULATE=false

# ============================================
# DROPBOX (PARA ARMAZENAMENTO)
# ============================================
DROPBOX_ACCESS_TOKEN=seu_token_dropbox
DROPBOX_APP_KEY=sua_app_key
DROPBOX_APP_SECRET=seu_app_secret

# ============================================
# GOOGLE (ANALYTICS, CALENDAR, LOGIN)
# ============================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_CALENDAR_API_KEY=sua_chave_google_calendar

# ============================================
# ZOHO
# ============================================
ZOHO_CLIENT_ID=seu_client_id_zoho
ZOHO_CLIENT_SECRET=seu_client_secret_zoho
ZOHO_REFRESH_TOKEN=seu_refresh_token_zoho

# ============================================
# SUPABASE (SE USAR)
# ============================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_chave_supabase

# ============================================
# LIVEKIT (WEBRTC / TELECONSULTA)
# ============================================
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=sua_api_key_livekit
LIVEKIT_API_SECRET=seu_api_secret_livekit

# ============================================
# VERCEL/RENDER (DEPLOYMENT)
# ============================================
FRONTEND_URL=https://integrativo.app
# Produção — cole no Render (integra-backend-ynrd):
# CORS_ORIGINS=https://integrativo.app,https://www.integrativo.app,https://integrativo.app.br,https://integrativoapp.com,https://integrativoapp.com.br,https://integra-saude-psi.vercel.app
VERCEL_URL=https://integrativo.app
RENDER_URL=https://integra-backend-ynrd.onrender.com

# ============================================
# LOGS E DEBUG
# ============================================
LOG_LEVEL=debug
DEBUG=true

# ============================================
# AUDITORIA LGPD
# Arquivos append-only em backend/logs/auditoria-lgpd/AAAA/MM/auditoria-AAAA-MM-DD.jsonl
# Espelhamento consultável em PostgreSQL: tabela logs_auditoria
# ============================================
AUDITORIA_LGPD_ATIVA=true
AUDITORIA_LGPD_RETENCAO_DIAS=1825
